[Unit]
Description=AI DHLR Python Script
After=network.target hotspot-startup.service sound.target

[Service]
User=linaro
# 在启动 Python 之前，由 root 执行权限修改
PermissionsStartOnly=true
ExecStartPre=/bin/bash -c "chmod -R 777 /sys/external_gpio/"
# 放开 NPU debugfs 读取权限：服务降权为 linaro 后读不了 debugfs（默认仅 root），
# 会导致 NPU 核心占用恒为 0。与 external_gpio 同理由 root 预先放开；用 || true 容错，
# 即便 debugfs 权限修改失败也不阻断主服务启动（仅 NPU 负载采集降级为 0）
ExecStartPre=/bin/bash -c "chmod a+x /sys/kernel/debug/ 2>/dev/null; chmod -R a+rX /sys/kernel/debug/rknpu/ 2>/dev/null || true"
# 增加音频组权限
SupplementaryGroups=audio
WorkingDirectory=/home/linaro/ai-dhlr
# 强制环境变量
Environment=SDL_AUDIODRIVER=alsa
Environment=AUDIODEV=hw:0,0
# 限制 glibc 内存池数量，减少多线程 malloc 碎片导致的 RSS 膨胀
# （glibc 默认 8×核数=32 个 arena；本机 4 核 → 32 个，碎片各自囤积不归还 OS）
# 必须在进程启动前由 systemd 注入，代码内 os.environ 设置无效
Environment=MALLOC_ARENA_MAX=2
# 抑制 OpenCV obsensor 模块 UVC 扫描警告：每次 VideoCapture 操作都往 stderr 刷
# 数条，经 journald→rsyslog 双写进 syslog，一年可积累数 GB。代码里 main.py 也在
# import cv2 前设置了同值，此处兜底（进程级注入不受 import 顺序影响）
Environment=OPENCV_LOG_LEVEL=ERROR
# 延时启动，确保硬件就绪
ExecStartPre=/bin/sleep 5
ExecStart=/home/linaro/miniforge3/envs/dhlr_env/bin/python /home/linaro/ai-dhlr/src/main.py

Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
