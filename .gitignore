# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 运行时产物
cache/
logs/
snapshots/

# 配置(含 token 等敏感信息, 勿入库; 另放 config.example.yaml 作模板)
config/config.yaml

# 大模型资产(部署时另行下发)
*.onnx
*.bin
*.pt
*.pth
*.rknn
*.tflite

# 压缩归档
*.zip
*.tar
*.tar.gz
*.7z

# 崩溃转储
*.stackdump

# Trae IDE
.trae/

# Claude Code 本地配置（勿入库）
.claude/

# 文档（二进制协议 pdf 等不纳入版本控制）
docs/

# 环境变量 / 密钥（保留 *.example 模板）
.env
.env.*
!.env.example
!.env.*.example

# IDE / 系统
.idea/
.vscode/
*.swp
.DS_Store
